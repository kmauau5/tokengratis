.snippetTabActive {
  background: var(--color-glass-active);
  color: var(--color-fog);
  border: 1px solid var(--color-ink-line);
  padding: 4px 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.snippetTab {
  background: transparent;
  color: var(--color-mute);
  border: 1px solid transparent;
  padding: 4px 12px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.snippetTab:hover {
  color: var(--color-fog);
}

.codeContainer {
  position: relative;
  background: var(--color-ink);
  border: 1px solid var(--color-ink-line);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.copyBtn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: var(--color-glass-active);
  backdrop-filter: blur(4px);
  border: 1px solid var(--color-ink-line);
  color: var(--color-fog);
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  font-size: 11px;
  cursor: pointer;
  transition: all 0.2s ease;
  z-index: 2;
}

.copyBtn:hover {
  background: var(--color-ink-line);
}

.codeBlock {
  margin: 0;
  padding: 16px;
  overflow-x: auto;
  font-family: monospace;
  font-size: 13px;
  line-height: 1.5;
  color: #e2e8f0;
}
